rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Måste kunna läsas av utloggade användare — kodnamnets tillgänglighet
    // kontrolleras innan kontot (och därmed inloggningen) skapas vid signup.
    match /codenames/{codename} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
